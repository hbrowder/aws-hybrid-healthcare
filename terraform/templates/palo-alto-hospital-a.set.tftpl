# =====================================================================
#  hospital-a-fw : Palo Alto VM-Series : AWS Hybrid Healthcare lab
#  Generated by Terraform from your live VPN. Contains the pre-shared keys:
#  keep this file local, never commit or share it.
#
#  How to apply (SSH to the management IP, 10.99.0.11):
#    > configure
#    # paste everything below, then:
#    # commit
#  Lines that delete factory objects may print "Invalid syntax" or
#  "does not exist" on a firewall that never had them. That's expected.
#  PAN-OS 10.x / 11.x, legacy routing engine.
# =====================================================================

# ---- 1. Clear the factory virtual wire so ethernet1/1-2 can be Layer 3
delete rulebase security rules rule1
delete network virtual-wire default-vwire
delete zone trust
delete zone untrust
delete network interface ethernet ethernet1/1
delete network interface ethernet ethernet1/2

# ---- 2. Identity
set deviceconfig system hostname hospital-a-fw

# ---- 3. Interfaces
# Outside: DHCP from the AT&T gateway, sending the hostname so the gateway lists it
# as hospital-a-fw. The DHCP default route points at 192.168.1.254.
set network interface ethernet ethernet1/1 layer3 dhcp-client enable yes
set network interface ethernet ethernet1/1 layer3 dhcp-client create-default-route yes
set network interface ethernet ethernet1/1 layer3 dhcp-client send-hostname enable yes
set network interface ethernet ethernet1/1 layer3 dhcp-client send-hostname hostname system-hostname

# Inside: the hospital LAN. MSS 1379 = 1500 - 121, so TCP fits the tunnel (ticket T03).
set network profiles interface-management-profile allow-ping ping yes
set network interface ethernet ethernet1/2 layer3 ip 10.0.1.5/24
set network interface ethernet ethernet1/2 layer3 interface-management-profile allow-ping
set network interface ethernet ethernet1/2 layer3 adjust-tcp-mss enable yes
set network interface ethernet ethernet1/2 layer3 adjust-tcp-mss ipv4-mss-adjustment 121

# Tunnel interfaces: the customer side of each AWS inside /30
set network interface tunnel units tunnel.1 ip ${t1_cgw_inside}/30
set network interface tunnel units tunnel.1 mtu 1427
set network interface tunnel units tunnel.2 ip ${t2_cgw_inside}/30
set network interface tunnel units tunnel.2 mtu 1427

# ---- 4. Zones and virtual router
set zone untrust network layer3 ethernet1/1
set zone trust network layer3 ethernet1/2
set zone vpn-aws network layer3 [ tunnel.1 tunnel.2 ]
set network virtual-router default interface [ ethernet1/1 ethernet1/2 tunnel.1 tunnel.2 ]

# ---- 5. Crypto (must match vpn.tf: AES-256, SHA-256, DH group 14, IKEv2)
set network ike crypto-profiles ike-crypto-profiles aws-ike dh-group group14
set network ike crypto-profiles ike-crypto-profiles aws-ike encryption aes-256-cbc
set network ike crypto-profiles ike-crypto-profiles aws-ike hash sha256
set network ike crypto-profiles ike-crypto-profiles aws-ike lifetime hours 8
set network ike crypto-profiles ipsec-crypto-profiles aws-ipsec esp encryption aes-256-cbc
set network ike crypto-profiles ipsec-crypto-profiles aws-ipsec esp authentication sha256
set network ike crypto-profiles ipsec-crypto-profiles aws-ipsec dh-group group14
set network ike crypto-profiles ipsec-crypto-profiles aws-ipsec lifetime hours 1

# ---- 6. IKE gateways. local-id = your public IP, or Phase 1 never forms behind AT&T NAT.
set network ike gateway aws-t1 protocol version ikev2
set network ike gateway aws-t1 protocol ikev2 ike-crypto-profile aws-ike
set network ike gateway aws-t1 protocol ikev2 dpd enable yes
set network ike gateway aws-t1 protocol-common nat-traversal enable yes
set network ike gateway aws-t1 authentication pre-shared-key key ${t1_psk}
set network ike gateway aws-t1 local-address interface ethernet1/1
set network ike gateway aws-t1 peer-address ip ${t1_outside}
set network ike gateway aws-t1 local-id type ipaddr id ${home_ip}

set network ike gateway aws-t2 protocol version ikev2
set network ike gateway aws-t2 protocol ikev2 ike-crypto-profile aws-ike
set network ike gateway aws-t2 protocol ikev2 dpd enable yes
set network ike gateway aws-t2 protocol-common nat-traversal enable yes
set network ike gateway aws-t2 authentication pre-shared-key key ${t2_psk}
set network ike gateway aws-t2 local-address interface ethernet1/1
set network ike gateway aws-t2 peer-address ip ${t2_outside}
set network ike gateway aws-t2 local-id type ipaddr id ${home_ip}

# ---- 7. IPsec tunnels (route-based, no proxy IDs)
set network tunnel ipsec aws-tunnel-1 auto-key ike-gateway aws-t1
set network tunnel ipsec aws-tunnel-1 auto-key ipsec-crypto-profile aws-ipsec
set network tunnel ipsec aws-tunnel-1 tunnel-interface tunnel.1
set network tunnel ipsec aws-tunnel-2 auto-key ike-gateway aws-t2
set network tunnel ipsec aws-tunnel-2 auto-key ipsec-crypto-profile aws-ipsec
set network tunnel ipsec aws-tunnel-2 tunnel-interface tunnel.2

# ---- 8. BGP: advertise only 100.64.1.0/24, anchored by a discard route (the Null0 trick)
set network virtual-router default routing-table ip static-route nat-anchor destination 100.64.1.0/24 nexthop discard
set network virtual-router default protocol redist-profile nat-anchor priority 1
set network virtual-router default protocol redist-profile nat-anchor filter type static
set network virtual-router default protocol redist-profile nat-anchor filter destination 100.64.1.0/24
set network virtual-router default protocol redist-profile nat-anchor action redist

set network virtual-router default protocol bgp router-id 10.0.1.5
set network virtual-router default protocol bgp enable yes
set network virtual-router default protocol bgp local-as 65010
set network virtual-router default protocol bgp install-route yes
set network virtual-router default protocol bgp redist-rules nat-anchor enable yes
set network virtual-router default protocol bgp redist-rules nat-anchor address-family-identifier ipv4
set network virtual-router default protocol bgp peer-group aws type ebgp
set network virtual-router default protocol bgp peer-group aws peer aws-t1 peer-as 64512
set network virtual-router default protocol bgp peer-group aws peer aws-t1 local-address interface tunnel.1
set network virtual-router default protocol bgp peer-group aws peer aws-t1 local-address ip ${t1_cgw_inside}/30
set network virtual-router default protocol bgp peer-group aws peer aws-t1 peer-address ip ${t1_aws_inside}
set network virtual-router default protocol bgp peer-group aws peer aws-t1 connection-options keep-alive-interval 10 hold-time 30
set network virtual-router default protocol bgp peer-group aws peer aws-t2 peer-as 64512
set network virtual-router default protocol bgp peer-group aws peer aws-t2 local-address interface tunnel.2
set network virtual-router default protocol bgp peer-group aws peer aws-t2 local-address ip ${t2_cgw_inside}/30
set network virtual-router default protocol bgp peer-group aws peer aws-t2 peer-address ip ${t2_aws_inside}
set network virtual-router default protocol bgp peer-group aws peer aws-t2 connection-options keep-alive-interval 10 hold-time 30

# ---- 9. NAT: overlapping-address fix first, then internet for the client's updates
set rulebase nat rules to-vendor from trust
set rulebase nat rules to-vendor to vpn-aws
set rulebase nat rules to-vendor source 10.0.1.0/24
set rulebase nat rules to-vendor destination any
set rulebase nat rules to-vendor service any
set rulebase nat rules to-vendor source-translation static-ip translated-address 100.64.1.0/24
set rulebase nat rules to-vendor source-translation static-ip bi-directional yes

set rulebase nat rules client-internet from trust
set rulebase nat rules client-internet to untrust
set rulebase nat rules client-internet source 10.0.1.0/24
set rulebase nat rules client-internet destination any
set rulebase nat rules client-internet service any
set rulebase nat rules client-internet source-translation dynamic-ip-and-port interface-address interface ethernet1/1

# ---- 10. Security policy (pre-NAT addresses, post-NAT zones)
set service tcp-8080 protocol tcp port 8080
set service tcp-2575 protocol tcp port 2575

set rulebase security rules hospital-to-vendor-ping from trust to vpn-aws source 10.0.1.0/24 destination 10.100.0.0/16 application ping service application-default action allow
set rulebase security rules hospital-to-vendor-apps from trust to vpn-aws source 10.0.1.0/24 destination 10.100.0.0/16 application any service [ tcp-8080 tcp-2575 ] action allow
set rulebase security rules vendor-to-hospital from vpn-aws to trust source 10.100.0.0/16 destination 100.64.1.0/24 application ping service application-default action allow
set rulebase security rules client-internet from trust to untrust source 10.0.1.0/24 destination any application any service any action allow

# Done. Now type: commit
